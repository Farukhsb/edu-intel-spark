# Supabase (auto-populated by Lovable Cloud)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_APP_URL="https://your-app.example.com"
# Set VITE_APP_URL to your production origin so canonical tags, robots.txt, and sitemap.xml use the correct domain.
VITE_APP_ENV="development"
VITE_SENTRY_DSN="https://public@example.ingest.sentry.io/1"

# PostHog Analytics
VITE_POSTHOG_KEY="your-posthog-key"
VITE_POSTHOG_HOST="https://us.i.posthog.com"
VITE_ANALYTICS_ENABLED="false"
VITE_INSTITUTION_SLUG="default"

# Backend secrets
# Configure backend secrets in Supabase Secrets, not in frontend env files.
# Example:
# supabase secrets set OPENAI_API_KEY=your-openai-api-key
# supabase secrets set OPENAI_CHAT_MODEL=gpt-4o-mini
# supabase secrets set OPENAI_GRADING_MODEL=gpt-4o-mini
# supabase secrets set OPENAI_INTEGRITY_MODEL=gpt-4o-mini
# Optional document-extraction fallback for unreadable PDFs
# supabase secrets set DOCLING_EXTRACTION_FALLBACK_ENABLED=true
# supabase secrets set DOCLING_EXTRACTION_FALLBACK_URL=https://your-docling-service/extract
# supabase secrets set DOCLING_EXTRACTION_FALLBACK_SECRET=your_shared_secret
# supabase secrets set DOCLING_EXTRACTION_FALLBACK_TIMEOUT_MS=15000
