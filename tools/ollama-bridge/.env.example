PORT=8790
NODE_ENV=production

# Local or remote Ollama instance
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# Optional shared secret. If set, clients must send x-api-key.
GRADEAI_API_SECRET=replace_with_a_long_random_secret

# Request tuning
OLLAMA_REQUEST_TIMEOUT_MS=180000
OLLAMA_BRIDGE_MAX_BODY_MB=10
